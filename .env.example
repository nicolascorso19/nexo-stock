# Servidor
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=0

# Persistencia. DB_PATH tiene prioridad; si es relativa se resuelve desde el cwd.
DATA_DIR=./data
# DB_PATH=./data/nexo.sqlite

# Seguridad y sesiones
# Usá true detrás de HTTPS. En producción debe ser true.
COOKIE_SECURE=false
COOKIE_NAME=nexo_session
LOGIN_RATE_LIMIT=10
BCRYPT_ROUNDS=12

# API
JSON_BODY_LIMIT=25mb
# Los datos demo sólo pueden habilitarse explícitamente en desarrollo/test.
# En producción debe ser false.
SEED_DEMO=false

# Web pública. La tienda del e-commerce es la única cara pública: /public y
# /public.html redirigen acá. Apuntá a la URL real si la tienda no está local.
STOREFRONT_URL=http://127.0.0.1:4100/

# Integración segura del e-commerce (el secreto se genera; no se comparte con el navegador)
COMMERCE_API_KEY_ID=nexo-store-local
COMMERCE_API_SECRET=cambiar-con-un-secreto-aleatorio-de-al-menos-32-caracteres
COMMERCE_RESERVATION_TTL_SECONDS=600
COMMERCE_WEBHOOKS_ENABLED=false
COMMERCE_WEBHOOK_URL=http://localhost:4000/api/integrations/stock/webhook
COMMERCE_WEBHOOK_KEY_ID=nexo-stock-local
COMMERCE_WEBHOOK_SECRET=cambiar-con-otro-secreto-aleatorio-de-al-menos-32-caracteres
