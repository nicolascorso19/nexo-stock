{
  "name": "nexo-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "E-commerce independiente conectado por API al sistema privado NEXO Stock",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "db:migrate": "node src/db/migrate.js",
    "db:verify": "node src/scripts/check-schema.js",
    "setup": "node src/scripts/setup-local.js",
    "admin:create": "node src/scripts/create-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.10.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "supertest": "^7.1.1"
  }
}
