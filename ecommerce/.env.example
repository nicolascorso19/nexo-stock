NODE_ENV=development
HOST=0.0.0.0
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
TRUST_PROXY=0
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
CART_TTL_HOURS=72
RESERVATION_MINUTES=10

# API privada: la misma clave/ secreto se configura en el sistema NEXO Stock.
STOCK_API_BASE_URL=http://localhost:3000
STOCK_API_KEY_ID=nexo-store-local
STOCK_API_SECRET=cambiar-con-un-secreto-aleatorio
STOCK_API_TIMEOUT_MS=5000

# Mercado Pago. Sin credenciales el checkout con tarjeta queda deshabilitado.
MERCADOPAGO_ENABLED=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SUCCESS_URL=http://localhost:4000/pedido/confirmacion
MERCADOPAGO_PENDING_URL=http://localhost:4000/pedido/confirmacion
MERCADOPAGO_FAILURE_URL=http://localhost:4000/checkout

# Email. Los pedidos se conservan si SMTP no está configurado.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=NEXO Store <no-reply@example.invalid>

# Webhooks desde NEXO Stock.
STOCK_WEBHOOKS_ENABLED=false
STOCK_WEBHOOK_URL=http://localhost:4000/api/integrations/stock/webhook
STOCK_WEBHOOK_KEY_ID=nexo-stock-local
STOCK_WEBHOOK_SECRET=cambiar-con-otro-secreto-aleatorio
